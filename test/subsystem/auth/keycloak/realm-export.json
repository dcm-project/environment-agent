{
  "realm": "dcm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "environment-agent",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${ENVIRONMENT_AGENT_CLIENT_SECRET}",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["openid", "profile", "email", "basic"],
      "protocolMappers": [
        {
          "name": "environment-agent-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "",
            "included.custom.audience": "environment-agent-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "environment-agent-no-audience",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${ENVIRONMENT_AGENT_NO_AUDIENCE_CLIENT_SECRET}",
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ]
}
