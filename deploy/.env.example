# Optional: copy to .env in the repo root and set for local overrides.
# Used by deploy/compose.yaml.

# --- Agent identity ---
# AGENT_NAME=local-agent
# AGENT_ENVIRONMENT=dev
# AGENT_COST=low
# AGENT_PORT=8081

# --- DCM integration ---
# Base URL only (agent registers at /api/v1alpha1/agents).
# Standalone stack default reaches control-plane on the host via host.docker.internal.
# DCM_REGISTRATION_URL=http://host.docker.internal:8080
# AGENT_MESSAGING_URL=nats://nats:4222

# --- Embedded service providers ---
# Service types: container, vm, cluster (comma-separated).
# AGENT_EMBEDDED_SPS=container,vm,cluster
# Optional kubeconfig for embedded SPs (shared by all SPs on this agent).
# Omit when no embedded SPs, or when the agent runs on Kubernetes and SPs use in-cluster config.
# Set for compose when embedded SPs reach an external cluster (e.g. Kind) from a container.
# Host path for the compose bind mount — not /kubeconfig (that is only inside the container).
# AGENT_KUBECONFIG_HOST=/path/to/kubeconfig
# AGENT_KUBECONFIG_HOST=${HOME}/.kube/config
# AGENT_KUBECONFIG_HOST=${PWD}/deploy/.kube/config   # after make kubeconfig-for-compose
# AGENT_SP_PERSISTENCE_PATH=/app/data/registrations   # compose default; writable by UID 1001
# CONTAINER_RESOURCE_ID=my-container-1  # optional, for make publish-creates
# VM_RESOURCE_ID=my-vm-1                  # optional, for make publish-creates
# SP_NAME=container-sp

# Container SP (when container is in AGENT_EMBEDDED_SPS)
# SP_K8S_NAMESPACE=default
# SP_K8S_EXTERNAL_SVC_TYPE=NodePort
# SP_MONITOR_DEBOUNCE_MS=500
# SP_MONITOR_RESYNC_PERIOD=10m

# VM SP (when vm is in AGENT_EMBEDDED_SPS; requires KubeVirt on Kind)
# KUBERNETES_NAMESPACE=default
# KUBERNETES_TIMEOUT=60s
# KUBERNETES_MAX_RETRIES=3
# EVENTS_ENABLED=true
# EVENTS_RESYNC_PERIOD=30m

# Cluster SP (when cluster is in AGENT_EMBEDDED_SPS; OpenShift ACM/MCE, not Kind)
# SP_CLUSTER_NAMESPACE=clusters
# SP_BASE_DOMAIN=apps.example.com
# SP_PULL_SECRET=<base64-encoded-dockerconfigjson>
# SP_CONSOLE_URI_PATTERN=https://console-openshift-console.apps.{name}.{base_domain}
# SP_VERSION_MATRIX_PATH=/path/to/version-matrix.yaml
# SP_ENABLED_PLATFORMS=kubevirt,baremetal
# SP_HEALTH_CHECK_TIMEOUT=5s
# SP_STATUS_DEBOUNCE_INTERVAL=1s
# SP_STATUS_RESYNC_INTERVAL=10m
# SP_NATS_PUBLISH_RETRY_MAX=3
# SP_NATS_PUBLISH_RETRY_INTERVAL=2s
# BareMetal (Agent) platform only (not to be confused with DCM environment-agent):
# SP_DEFAULT_INFRA_ENV=my-infra-env
# SP_AGENT_NAMESPACE=my-agent-namespace  # ACM agent-install namespace (Agent CRs on management cluster)
# SP_INFRA_ENV_LABEL_KEY=infraenvs.agent-install.openshift.io

# --- Image version ---
# ENVIRONMENT_AGENT_VERSION=main
